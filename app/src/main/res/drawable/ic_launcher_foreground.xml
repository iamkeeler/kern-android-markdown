<?xml version="1.0" encoding="utf-8"?>
<!--
    Serif "K" foreground for adaptive icon.
    The safe zone for adaptive icons is the inner 72dp (18dp inset on each side).
    The K is drawn in cream/off-white (#F5F0E8) to match the generated icon.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
        Serif K constructed from filled paths.
        Viewport: 108x108. Safe zone: x=[18,90], y=[18,90] (72x72dp).
        The K occupies roughly x=[26,82], y=[20,88].

        Anatomy of a serif K:
          - Vertical stem (left stroke) with top and bottom serifs
          - Upper diagonal arm going from mid-stem to top-right, with serif
          - Lower diagonal leg going from mid-stem to bottom-right, with serif
          - The junction area is treated with a small spur

        Using a hand-crafted path for a classic Book Antiqua / Times-style K.
    -->

    <!-- Vertical stem: x from 26 to 37, y from 20 to 88, with horizontal serifs -->
    <!-- Bottom-left serif -->
    <path
        android:fillColor="#F5F0E8"
        android:pathData="
            M22,85 L22,88 L41,88 L41,85
            C41,85 38,84.5 38,82
            L38,26
            C38,23.5 41,23 41,23 L41,20 L22,20 L22,23
            C22,23 25,23.5 25,26
            L25,82
            C25,84.5 22,85 22,85 Z
        " />

    <!--
        Upper arm of K (diagonal going upper-right).
        Starts at the mid-point of the stem (~y=54) and goes to upper-right corner.
        A serif K arm has a slight curve inward. We approximate with a quadrilateral + serif cap.
    -->
    <path
        android:fillColor="#F5F0E8"
        android:pathData="
            M37,54
            L37,48
            L64,22
            C65,21 66.5,20.5 68,20
            L82,20
            L82,23
            C80,23.5 78.5,24.5 77,26
            L50,52
            C49,53 49,55 50,56
            L78,82
            C79.5,83.5 81,84.5 83,85
            L83,88
            L68,88
            C66.5,87.5 65,87 64,86
            L37,60
            L37,54 Z
        " />

    <!-- Notch fill to clean up junction between stem and arms at mid-point -->
    <path
        android:fillColor="#F5F0E8"
        android:pathData="
            M38,51 L38,57 L44,57 L50,54 L44,51 Z
        " />

</vector>